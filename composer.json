{
    "name": "leroy-merlin-br/metamorphosis",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "kafka"
    ],
    "description": "Kafka package for laravel applications",
    "require": {
        "php": "^8.3",
        "ext-rdkafka": ">=4.0",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^6.5.0 || ^7.15.2",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/config": "^13.0",
        "rg/avro-php": "^3.0"
    },
    "require-dev": {
        "leroy-merlin-br/coding-standard": "^v3.1.0",
        "phpunit/phpunit": "^12.5",
        "mockery/mockery": "^1.6.12",
        "kwn/php-rdkafka-stubs": "^2.2.1",
        "orchestra/testbench": "^11.1",
        "phpro/grumphp": "^v2.21.0",
        "vimeo/psalm": "^6.16",
        "psalm/plugin-mockery": "^1.2.1",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Metamorphosis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Boitata Team",
            "email": "boitata@leroymerlin.com.br"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Metamorphosis\\MetamorphosisServiceProvider"
            ]
        },
        "aliases": {
            "Metamorphosis": "Metamorphosis\\Facades\\Metamorphosis"
        }
    },
    "scripts": {
        "setup-dev": [
            "@composer install",
            "vendor/bin/grumphp git:init"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        }
    }
}
